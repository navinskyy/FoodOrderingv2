<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="15dp"
    tools:context=".drinks_layout">

    <LinearLayout
        android:id="@+id/drinksheader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#AB3834">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_margin="10dp"
            android:gravity="center_horizontal"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="19dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drinks List"
                android:textColor="#fcfafa"
                android:textSize="20sp"
                android:textStyle="bold"></TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This are the drinks list that we serve!"
                android:textColor="#fcfafa"
                android:textSize="20sp"
                android:textStyle="bold"></TextView>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/imageview2"
        android:layout_width="wrap_content"
        android:layout_height="300dp"
        android:layout_marginTop="150dp"
        android:src="@drawable/icedcoffee"
        />

    <LinearLayout
        android:id="@+id/drinkNamePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@+id/imageview2"
        >
        <TextView
            android:id="@+id/drinkName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Iced Coffee"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000" />

        <TextView
            android:id="@+id/drinkPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="₱75.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000" />
    </LinearLayout>


    <TextView
        android:id="@+id/qty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/drinkNamePrice"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:text="QTY : 0"
        android:textColor="#000"
        android:textSize="25sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/addtocart2btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_below="@id/qty">

        <Button
            android:layout_margin="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/plus"
            android:backgroundTint="#AB3834"
            android:layout_weight="1"
            android:text="+"/>

        <Button
            android:layout_margin="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#AB3834"
            android:id="@+id/minus"
            android:layout_weight="1"
            android:text="-"/>

        <Button
            android:layout_margin="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#AB3834"
            android:id="@+id/addtocartbtndrinks"
            android:text="Add to Cart"
            android:layout_weight="2"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/SwitchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="8"
        android:layout_alignParentBottom="true"
        >

        <Button
            android:id="@+id/DrinkBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="2"
            android:backgroundTint="#AB3834"
            android:text="HOME" />

        <Button
            android:id="@+id/Previous"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="3"
            android:backgroundTint="#AB3834"
            android:text="Previous" />

        <Button
            android:id="@+id/Next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="3"
            android:backgroundTint="#AB3834"
            android:text="Next" />
    </LinearLayout>
</RelativeLayout>