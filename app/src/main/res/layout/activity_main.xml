<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="15dp"
    tools:context=".MainActivity">


    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hi Student"
                android:textColor="#AB3834"
                android:textSize="20sp"
                android:textStyle="bold"></TextView>

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order &amp; Grab"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"></TextView>
        </LinearLayout>

        <ImageView
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:srcCompat="@drawable/usericon"></ImageView>


    </LinearLayout>

    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:background="#Ececec"
        android:drawableStart="@drawable/search"
        android:drawablePadding="10dp"
        android:ems="10"
        android:hint="Find your Food"
        android:inputType="textPersonName"
        android:padding="10dp"
        android:singleLine="true"
        android:maxLines="1"
        android:imeOptions="actionSearch"
        android:text="Find Your Food"
        android:textColor="#000"
        android:textStyle="italic"
        tools:ignore="TouchTargetSizeCheck"></EditText>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#AB3834">

        <ImageView
            android:id="@+id/image1"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:layout_alignParentLeft="true"
            app:srcCompat="@drawable/foodchicken" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="19dp">

            <TextView
                android:id="@+id/fastordering"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast Ordering"
                android:textColor="#fcfafa"
                android:textSize="15sp"
                android:textStyle="bold"></TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solution for your 20 - minute break"
                android:textColor="#fcfafa"
                android:textSize="14sp"
                android:textStyle="bold"></TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#AB3834"
                android:backgroundTint="#ff6242"
                android:text="Order Now"
                android:textColor="#fcfafa"
                android:textSize="15sp"
                android:textStyle="bold"></TextView>
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:text="Categories"
            android:textColor="#000000"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/categoryrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="30dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">


                <ImageButton
                    android:id="@+id/foodBtn"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:background="#FFFEE9"
                    android:scaleType="fitCenter"
                    android:src="@drawable/meals" />


                <ImageButton
                    android:id="@+id/drinksBtn"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:background="#C7F6B6"
                    android:scaleType="fitCenter"
                    android:src="@drawable/drinks" />

                <ImageButton
                    android:id="@+id/breadsBtn"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:background="#EACAFF"
                    android:scaleType="fitCenter"
                    android:src="@drawable/breads" />

                <ImageButton
                    android:id="@+id/chipsBtn"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:background="#D1E5F4"
                    android:scaleType="fitCenter"
                    android:src="@drawable/chips" />

            </LinearLayout>

        </HorizontalScrollView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Popular"
            android:textColor="#000000"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/popularscrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/pepperoniBtn"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:background="#CAFDE1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pepperoni" />

                <ImageButton
                    android:id="@+id/cocacolaBtn"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:background="#FBB3BD"
                    android:scaleType="fitCenter"
                    android:src="@drawable/omsim" />

                <ImageButton
                    android:id="@+id/ricefilletBtn"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:background="#FFEE93"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ricefillet" />

                <ImageButton
                    android:id="@+id/piattosBtn"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="15dp"
                    android:background="#E0BBE4"
                    android:scaleType="fitCenter"
                    android:src="@drawable/piattos" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#AB3834"
            android:orientation="horizontal"
            android:weightSum="5">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#882020"
                android:drawableTop="@drawable/bottom_btn1"
                android:text="HOME"
                android:textSize="7sp" />

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#882020"
                android:drawableTop="@drawable/bottom_btn2"
                android:text="PROFILE"
                android:textSize="7sp" />

            <Button
                android:id="@+id/btnSupprot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#882020"
                android:drawableTop="@drawable/bottom_btn3"
                android:text="SUPPORT"
                android:textSize="7sp" />

            <Button
                android:id="@+id/btnTools"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#882020"
                android:drawableTop="@drawable/bottom_btn4"
                android:text="TOOLS"
                android:textSize="7sp" />

            <Button
                android:id="@+id/btnAddToCart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:backgroundTint="#882020"
                android:drawableTop="@drawable/bottom_btn5"
                android:text="ADD TO CART"
                android:textSize="7sp" />

        </LinearLayout>
    </RelativeLayout>

</LinearLayout>