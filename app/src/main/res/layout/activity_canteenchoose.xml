<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background3"
    tools:context=".canteenchoose">

    <TextView
        android:id="@+id/choose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="90dp"
        android:gravity="center"
        android:text="CHOOSE THE CANTEEN"
        android:textColor="@color/black"
        android:textSize="25dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/canteenbtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/choose"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        android:layout_marginStart="22dp"
        android:layout_marginTop="148dp"
        android:layout_marginEnd="20dp"
        android:height="100dp"
        android:backgroundTint="#8A0000"
        android:drawableLeft="@drawable/baseline_business_24"
        android:text="TYK CANTEEN"
        android:textAllCaps="false"
        android:textSize="20sp" />

    <Button
        android:id="@+id/canteenbtn2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/canteenbtn"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        android:layout_marginStart="22dp"
        android:layout_marginTop="248dp"
        android:layout_marginEnd="20dp"
        android:height="100dp"
        android:backgroundTint="#8A0000"
        android:drawableLeft="@drawable/baseline_business_24"
        android:text="LCT CANTEEN"
        android:textAllCaps="false"
        android:textSize="20sp" />

    <Button
        android:id="@+id/canteenbtn3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/canteenbtn2"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        android:layout_marginStart="22dp"
        android:layout_marginTop="348dp"
        android:layout_marginEnd="20dp"
        android:height="100dp"
        android:backgroundTint="#8A0000"
        android:text="URBAN CANTEEN"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:drawableLeft="@drawable/baseline_business_24"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logoutBTN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/canteenbtn3"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:backgroundTint="@color/cardview_dark_background"
        android:text="LOGOUT" />

</RelativeLayout>